{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learn-site",
  // Static Astro output only. There is no Worker script.
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Custom domain for this hostname only, in the technokong.xyz zone.
  // Does not attach technokong.xyz itself or any other Worker.
  "routes": [
    {
      "pattern": "learn.technokong.xyz",
      "zone_name": "technokong.xyz",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
