---
import { getCollection } from 'astro:content';
import ItemCard from '../../components/ItemCard.astro';
import { byAddedDesc } from '../../lib/items';
import { DOMAINS, SOURCE_TYPES, STATUSES, VALUES } from '../../lib/taxonomy';
import Base from '../../layouts/Base.astro';

const items = (await getCollection('items')).sort(byAddedDesc);
const filters = [
  { key: 'status', label: '状态', options: STATUSES },
  { key: 'domain', label: '领域', options: DOMAINS },
  { key: 'value', label: '价值', options: VALUES },
  { key: 'type', label: '类型', options: SOURCE_TYPES },
] as const;
---

<Base
  title="全部条目"
  description="按状态、领域、价值和来源类型筛选 Ryan 的学习条目，并按加入日期排序。"
  current="items"
>
  <div class="shell">
    <header class="page-intro">
      <h1>全部条目</h1>
      <p>筛选在这台浏览器里完成。默认按加入日期从新到旧。卡片上的状态来自文件；「本机读到」是这台浏览器另记的进度。</p>
    </header>

    <form class="filters" id="filters" aria-label="筛选与排序">
      {
        filters.map((group) => (
          <fieldset class="filter-group">
            <legend>{group.label}</legend>
            <button type="button" class="chip" data-filter={group.key} data-value="all" aria-pressed="true">
              全部
            </button>
            {group.options.map((option) => (
              <button type="button" class="chip" data-filter={group.key} data-value={option} aria-pressed="false">
                {option}
              </button>
            ))}
          </fieldset>
        ))
      }
      <fieldset class="filter-group">
        <legend>加入日期</legend>
        <button type="button" class="chip" data-filter="sort" data-value="newest" aria-pressed="true">最新</button>
        <button type="button" class="chip" data-filter="sort" data-value="oldest" aria-pressed="false">最早</button>
      </fieldset>
    </form>

    <div class="result-bar">
      <p id="result-count">显示 {items.length} / {items.length} 条</p>
      <button type="button" class="text-button" id="reset-filters" hidden>清除筛选</button>
    </div>

    <div class="card-grid" id="item-list">
      {items.map((item) => <ItemCard item={item} />)}
    </div>
    <p class="empty" id="empty-filter" hidden>没有符合条件的条目。</p>
  </div>
</Base>

<script>
  const list = document.querySelector<HTMLElement>('#item-list');
  const empty = document.querySelector<HTMLElement>('#empty-filter');
  const count = document.querySelector<HTMLElement>('#result-count');
  const reset = document.querySelector<HTMLButtonElement>('#reset-filters');
  if (!list || !empty || !count || !reset) {
    throw new Error('item list controls missing');
  }

  const cards = [...list.querySelectorAll<HTMLElement>('[data-item]')];
  const total = cards.length;
  const state = {
    status: 'all',
    domain: 'all',
    value: 'all',
    type: 'all',
    sort: 'newest',
  };

  const apply = () => {
    const sorted = cards.slice().sort((a, b) => {
      const left = Number(a.dataset.added);
      const right = Number(b.dataset.added);
      return state.sort === 'oldest' ? left - right : right - left;
    });

    let visible = 0;
    for (const card of sorted) {
      const match =
        (state.status === 'all' || card.dataset.status === state.status) &&
        (state.domain === 'all' || card.dataset.domain === state.domain) &&
        (state.value === 'all' || card.dataset.value === state.value) &&
        (state.type === 'all' || card.dataset.type === state.type);
      card.hidden = !match;
      if (match) visible += 1;
      list.appendChild(card);
    }

    empty.hidden = visible !== 0 || total === 0;
    count.textContent = `显示 ${visible} / ${total} 条`;
    const filtered =
      state.status !== 'all' ||
      state.domain !== 'all' ||
      state.value !== 'all' ||
      state.type !== 'all' ||
      state.sort !== 'newest';
    reset.hidden = !filtered;
  };

  const press = (key: string, value: string) => {
    document.querySelectorAll<HTMLButtonElement>(`[data-filter="${key}"]`).forEach((button) => {
      button.setAttribute('aria-pressed', button.dataset.value === value ? 'true' : 'false');
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.filter;
      const value = button.dataset.value;
      if (!key || !value || !(key in state)) return;
      state[key as keyof typeof state] = value;
      press(key, value);
      const url = new URL(window.location.href);
      const isDefault = value === 'all' || (key === 'sort' && value === 'newest');
      if (isDefault) url.searchParams.delete(key);
      else url.searchParams.set(key, value);
      history.replaceState(null, '', url);
      apply();
    });
  });

  reset.addEventListener('click', () => {
    state.status = 'all';
    state.domain = 'all';
    state.value = 'all';
    state.type = 'all';
    state.sort = 'newest';
    for (const key of Object.keys(state)) {
      press(key, state[key as keyof typeof state]);
    }
    history.replaceState(null, '', window.location.pathname);
    apply();
  });

  const params = new URLSearchParams(window.location.search);
  for (const key of Object.keys(state) as Array<keyof typeof state>) {
    const value = params.get(key);
    if (!value) continue;
    const button = document.querySelector<HTMLButtonElement>(
      `[data-filter="${key}"][data-value="${CSS.escape(value)}"]`,
    );
    if (!button) continue;
    state[key] = value;
    press(key, value);
  }
  apply();
</script>
